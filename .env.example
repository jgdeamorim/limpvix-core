# LimpVix Core - Environment Configuration
# ===========================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env to version control!

# ============================================
# ENVIRONMENT
# ============================================
# Options: development, staging, production
# Controls debug mode, logging, error display
LIMPVIX_ENV=development

# ============================================
# DEBUG & LOGGING
# ============================================
# Enable/disable debug mode (true/false)
# Development: true
# Production: false
LIMPVIX_DEBUG=true

# Log level (error, warning, info, debug)
LIMPVIX_LOG_LEVEL=debug

# Enable SQL query logging (true/false)
# WARNING: Performance impact, use only in development
LIMPVIX_LOG_QUERIES=false

# ============================================
# MERCADO PAGO (Payment Gateway)
# ============================================
# IMPORTANT: These override wp_options if set
# If empty, falls back to values synced from WooCommerce MP plugin

# Production Credentials
LIMPVIX_MP_ACCESS_TOKEN_PROD=
LIMPVIX_MP_PUBLIC_KEY_PROD=

# Test/Sandbox Credentials
LIMPVIX_MP_ACCESS_TOKEN_TEST=
LIMPVIX_MP_PUBLIC_KEY_TEST=

# Active environment (production/sandbox)
# This determines which credentials to use
LIMPVIX_MP_ENVIRONMENT=sandbox

# ============================================
# TWILIO (SMS Notifications)
# ============================================
# Twilio Account SID (starts with AC...)
LIMPVIX_TWILIO_ACCOUNT_SID=

# Twilio Auth Token
LIMPVIX_TWILIO_AUTH_TOKEN=

# Twilio Phone Number (format: +5521999999999)
LIMPVIX_TWILIO_FROM_NUMBER=

# Enable Twilio notifications (true/false)
LIMPVIX_TWILIO_ENABLED=false

# ============================================
# 360DIALOG (WhatsApp Business API)
# ============================================
# 360Dialog API Key
LIMPVIX_360DIALOG_API_KEY=

# WhatsApp Phone Number ID
LIMPVIX_360DIALOG_PHONE_ID=

# Enable WhatsApp notifications (true/false)
LIMPVIX_360DIALOG_ENABLED=false

# ============================================
# GOOGLE MEU NEGÓCIO (Reviews)
# ============================================
# Google My Business Place ID
LIMPVIX_GMB_PLACE_ID=

# Direct review URL (short link)
LIMPVIX_GMB_REVIEW_URL=

# Enable GMB integration (true/false)
LIMPVIX_GMB_ENABLED=false

# ============================================
# FIREBASE (Authentication - optional)
# ============================================
# Firebase Project ID
LIMPVIX_FIREBASE_PROJECT_ID=

# Firebase API Key
LIMPVIX_FIREBASE_API_KEY=

# Firebase Auth Domain
LIMPVIX_FIREBASE_AUTH_DOMAIN=

# Enable Firebase auth (true/false)
LIMPVIX_FIREBASE_ENABLED=false

# ============================================
# FEATURE FLAGS
# ============================================
# Enable new Professional registration flow (true/false)
LIMPVIX_FEATURE_NEW_REGISTRATION=false

# Enable automated payouts (true/false)
# Development: false
# Production: true (after testing)
LIMPVIX_FEATURE_AUTO_PAYOUTS=false

# Enable recurring contracts (true/false)
LIMPVIX_FEATURE_RECURRING_CONTRACTS=false

# Enable feedback window system (true/false)
LIMPVIX_FEATURE_FEEDBACK_WINDOW=false

# Enable admin notifications (true/false)
LIMPVIX_FEATURE_ADMIN_NOTIFICATIONS=true

# ============================================
# CRON JOBS
# ============================================
# Enable WP Cron (true/false)
# Set to false if using system cron
LIMPVIX_CRON_ENABLED=true

# Cron job execution timeout (seconds)
LIMPVIX_CRON_TIMEOUT=300

# Health check max age for daily jobs (hours)
LIMPVIX_CRON_MAX_AGE_DAILY=25

# ============================================
# API & WEBHOOKS
# ============================================
# Enable REST API (true/false)
LIMPVIX_API_ENABLED=true

# API rate limiting (requests per minute)
LIMPVIX_API_RATE_LIMIT=60

# Webhook secret for external services
LIMPVIX_WEBHOOK_SECRET=

# ============================================
# EXTERNAL SERVICES
# ============================================
# External monitoring service URL (UptimeRobot, Pingdom, etc)
LIMPVIX_MONITORING_URL=

# Healthchecks.io ping URL (optional)
LIMPVIX_HEALTHCHECKS_PING_URL=

# Slack webhook for alerts (optional)
LIMPVIX_SLACK_WEBHOOK_URL=

# ============================================
# DATABASE (Advanced)
# ============================================
# Enable database transactions (true/false)
# Should always be true in production
LIMPVIX_DB_TRANSACTIONS=true

# Enable query cache (true/false)
LIMPVIX_DB_CACHE=true

# Cache TTL in seconds
LIMPVIX_DB_CACHE_TTL=3600

# ============================================
# SECURITY
# ============================================
# JWT Secret for API authentication (if implemented)
LIMPVIX_JWT_SECRET=

# Enable CORS (true/false)
# Only enable if API is accessed from external domains
LIMPVIX_CORS_ENABLED=false

# Allowed CORS origins (comma-separated)
LIMPVIX_CORS_ORIGINS=

# ============================================
# TESTING
# ============================================
# Enable test mode (bypasses some validations)
# NEVER enable in production!
LIMPVIX_TEST_MODE=false

# Seed database with test data on activation (true/false)
LIMPVIX_SEED_TEST_DATA=false

# ============================================
# CUSTOM SETTINGS
# ============================================
# Custom setting 1 (example)
# LIMPVIX_CUSTOM_SETTING_1=

# Custom setting 2 (example)
# LIMPVIX_CUSTOM_SETTING_2=

# ===========================================
# NOTES
# ===========================================
# 1. After changing values, restart your web server or clear caches
# 2. Boolean values: use 'true' or 'false' (lowercase)
# 3. Empty values will fall back to defaults or wp_options
# 4. Sensitive values (tokens, keys) should NEVER be committed to git
# 5. Add .env to .gitignore to prevent accidental commits
#
# For more information, see: docs/ENVIRONMENT-SETUP.md
