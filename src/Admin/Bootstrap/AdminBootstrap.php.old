<?php
/**
 * AdminBootstrap - Inicialização do Módulo Admin
 *
 * RESPONSABILIDADE:
 * - Registrar menu administrativo
 * - Registrar assets (CSS, JS)
 * - Inicializar controllers
 * - Gate de permissões
 *
 * PRINCÍPIOS:
 * - Single Responsibility
 * - Lazy Loading
 * - Security First
 *
 * MENU STRUCTURE:
 * LimpVix
 *   ├── Configurações (default)
 *   ├── Dashboard
 *   ├── Orders
 *   └── Payouts
 *
 * PASSO 5.6.1 - Infraestrutura Admin
 *
 * @package LimpVix\Admin\Bootstrap
 */

namespace LimpVix\Admin\Bootstrap;

use LimpVix\Admin\Capabilities\FinanceCapabilities;
use LimpVix\Admin\Controllers\OrdersListController;
use LimpVix\Admin\Controllers\OrderDetailController;
use LimpVix\Admin\Controllers\AdminActionsController;
use LimpVix\Admin\Settings\MercadoPagoSettings;
use LimpVix\Admin\Settings\TestVendorsManager;
use LimpVix\Admin\Settings\MercadoPagoDetector;

defined('ABSPATH') || exit;

class AdminBootstrap
{
    /**
     * Slug do menu principal
     */
    private const MENU_SLUG = 'limpvix-finance';

    /**
     * Capabilities
     *
     * @var FinanceCapabilities
     */
    private $capabilities;

    /**
     * Controllers
     *
     * @var array
     */
    private $controllers = [];

    /**
     * Construtor
     */
    public function __construct()
    {
        $this->capabilities = new FinanceCapabilities();
    }

    /**
     * Inicializar módulo admin
     *
     * @return void
     */
    public function boot(): void
    {
        // Registrar capabilities
        add_action('admin_init', [$this, 'registerCapabilities']);

        // Registrar menu
        add_action('admin_menu', [$this, 'registerMenu']);

        // Registrar assets
        add_action('admin_enqueue_scripts', [$this, 'registerAssets']);

        // Registrar hooks AJAX do Mercado Pago
        MercadoPagoSettings::registerHooks();
        TestVendorsManager::registerHooks();
        MercadoPagoDetector::registerSyncHooks();

        // Inicializar controllers
        $this->initializeControllers();
    }

    /**
     * Registrar capabilities
     *
     * @return void
     */
    public function registerCapabilities(): void
    {
        // Registrar apenas uma vez (usar transient como flag)
        if (get_transient('limpvix_finance_caps_registered')) {
            return;
        }

        $this->capabilities->register();
        set_transient('limpvix_finance_caps_registered', true, WEEK_IN_SECONDS);
    }

    /**
     * Registrar menu
     *
     * ESTRUTURA:
     * - Menu Principal: "LimpVix" (com ícone)
     *   - Configurações (página principal)
     *   - Dashboard
     *   - Orders
     *   - Payouts
     *
     * @return void
     */
    public function registerMenu(): void
    {
        // Verificar permissão mínima
        if (!FinanceCapabilities::canView()) {
            return;
        }

        // Menu principal "LimpVix"
        add_menu_page(
            'LimpVix',                        // Page title
            'LimpVix',                        // Menu title
            'limpvix_finance_view',           // Capability
            self::MENU_SLUG,                  // Menu slug (limpvix-finance)
            [$this, 'renderSettingsPage'],    // Callback → Configurações
            'dashicons-admin-generic',        // Icon (engrenagem)
            30                                // Position
        );

        // Submenu 1: Configurações (página padrão)
        add_submenu_page(
            self::MENU_SLUG,
            'Configurações LimpVix',          // Page title
            'Configurações',                  // Menu title
            'limpvix_finance_manage',         // Capability (mais restrito)
            self::MENU_SLUG,                  // Menu slug (mesmo do menu principal)
            [$this, 'renderSettingsPage']     // Callback
        );

        // Submenu 2: Dashboard (visão geral)
        add_submenu_page(
            self::MENU_SLUG,
            'Dashboard LimpVix',
            'Dashboard',
            'limpvix_finance_view',
            'limpvix-dashboard',
            [$this, 'renderDashboardPage']
        );

        // Submenu 3: Orders
        add_submenu_page(
            self::MENU_SLUG,
            'Orders Financeiras',
            'Orders',
            'limpvix_finance_view',
            'limpvix-orders',
            [$this, 'renderOrdersPage']
        );

        // Submenu 4: Payouts
        add_submenu_page(
            self::MENU_SLUG,
            'Histórico de Payouts',
            'Payouts',
            'limpvix_finance_view',
            'limpvix-payouts',
            [$this, 'renderPayoutsPage']
        );
    }

    /**
     * Registrar assets (CSS, JS)
     *
     * @param string $hook Current page hook
     * @return void
     */
    public function registerAssets(string $hook): void
    {
        // Apenas carregar nas páginas do Limpvix Finance
        if (strpos($hook, self::MENU_SLUG) === false) {
            return;
        }

        // CSS
        wp_enqueue_style(
            'limpvix-finance-admin',
            plugins_url('assets/finance.css', dirname(__DIR__)),
            [],
            '1.0.0'
        );

        // JS
        wp_enqueue_script(
            'limpvix-finance-admin',
            plugins_url('assets/finance.js', dirname(__DIR__)),
            ['jquery'],
            '1.0.0',
            true
        );

        // Localize script (dados para JS)
        wp_localize_script('limpvix-finance-admin', 'limpvixFinance', [
            'ajaxUrl' => admin_url('admin-ajax.php'),
            'nonce' => wp_create_nonce('limpvix_finance_actions'),
            'capabilities' => [
                'canView' => FinanceCapabilities::canView(),
                'canManage' => FinanceCapabilities::canManage(),
                'canPayout' => FinanceCapabilities::canPayout()
            ]
        ]);
    }

        // CSS
        wp_enqueue_style(
            'limpvix-finance-admin',
            plugins_url('assets/finance.css', dirname(__DIR__)),
            [],
            '1.0.0'
        );

        // JS
        wp_enqueue_script(
            'limpvix-finance-admin',
            plugins_url('assets/finance.js', dirname(__DIR__)),
            ['jquery'],
            '1.0.0',
            true
        );

        // Localize script (dados para JS)
        wp_localize_script('limpvix-finance-admin', 'limpvixFinance', [
        // Localize script (dados para JS)
        wp_localize_script('limpvix-finance-admin', 'limpvixFinance', [
            'ajaxUrl' => admin_url('admin-ajax.php'),
            'nonce' => wp_create_nonce('limpvix_finance_actions'),
            'capabilities' => [
                'canView' => FinanceCapabilities::canView(),
                'canManage' => FinanceCapabilities::canManage(),
                'canPayout' => FinanceCapabilities::canPayout()
            ]
        ]);

        // Enfileirar assets do Mercado Pago
        wp_enqueue_style(
            'limpvix-mp-styles',
            plugins_url('src/Admin/Settings/assets/css/limpvix-mp.css', dirname(__DIR__)),
            [],
            '1.0.1'
        );

        wp_enqueue_script(
            'limpvix-mp-script',
            plugins_url('src/Admin/Settings/assets/js/limpvix-mp.js', dirname(__DIR__)),
            ['jquery'],
            '1.0.1',
            true
        );

        wp_localize_script('limpvix-mp-script', 'limpvixMPData', [
            'nonce' => wp_create_nonce('limpvix_mp_actions'),
            'ajaxUrl' => admin_url('admin-ajax.php'),
        ]);
            ]
        ]);
    }

    /**
     * Inicializar controllers
     *
     * @return void
     */
    private function initializeControllers(): void
    {
        // Controllers serão inicializados conforme necessário
        // Por ora, apenas preparar estrutura

        $this->controllers['orders_list'] = null; // Lazy load
        $this->controllers['order_detail'] = null; // Lazy load
        $this->controllers['admin_actions'] = null; // Lazy load
    }

    /**
     * Obter controller
     *
     * @param string $name Nome do controller
     * @return object|null
     */
    public function getController(string $name)
    {
        if (!isset($this->controllers[$name])) {
            return null;
        }

        // Lazy load
        if ($this->controllers[$name] === null) {
            $this->controllers[$name] = $this->instantiateController($name);
        }

        return $this->controllers[$name];
    }

    /**
     * Instanciar controller
     *
     * @param string $name
     * @return object|null
     */
    private function instantiateController(string $name)
    {
        switch ($name) {
            case 'orders_list':
                return new OrdersListController();
            case 'order_detail':
                return new OrderDetailController();
            case 'admin_actions':
                return new AdminActionsController();
            default:
                return null;
        }
    }

    /**
     * Renderizar página de Configurações
     *
     * @return void
     */
    public function renderSettingsPage(): void
    {
        if (!FinanceCapabilities::canManage()) {
            wp_die('Acesso negado');
        }

        ?>
        <div class="wrap limpvix-finance">
            <h1>
                <span class="dashicons dashicons-admin-generic"></span>
                Configurações LimpVix
            </h1>

            <div class="limpvix-settings-container">
                <!-- Feature Flags -->
                <div class="limpvix-card">
                    <h2>Feature Flags</h2>
                    <p>Controle das funcionalidades do sistema.</p>

                    <?php
                    $flags = new \LimpVix\Core\FeatureFlags();
                    $all_flags = $flags->getAll();

                    $important_flags = [
                        'financial_workflow' => 'Workflow Financeiro',
                        'payout_engine' => 'Motor de Payouts',
                        'admin_interface' => 'Interface Admin',
                        'audit_logging' => 'Logs de Auditoria',
                    ];
                    ?>

                    <table class="widefat">
                        <thead>
                            <tr>
                                <th>Flag</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($important_flags as $flag => $label): ?>
                            <tr>
                                <td><strong><?php echo esc_html($label); ?></strong></td>
                                <td>
                                    <?php if (isset($all_flags[$flag]) && $all_flags[$flag]): ?>
                                        <span class="limpvix-status-badge authorized">✅ Habilitado</span>
                                    <?php else: ?>
                                        <span class="limpvix-status-badge blocked">❌ Desabilitado</span>
                                    <?php endif; ?>
                                </td>
                            </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>

                <!-- Configurações Mercado Pago -->
                <?php MercadoPagoSettings::render(); ?>

                <!-- Contas de Teste -->
                <?php TestVendorsManager::render(); ?>

                <!-- Health Check -->
                <div class="limpvix-card">
                    <h2>Health Check</h2>
                    <?php
                    $kernel = \LimpVix\Core\Kernel::getInstance();
                    $health = $kernel->healthCheck();
                    ?>
                    <table class="widefat">
                        <tr>
                            <td><strong>Versão</strong></td>
                            <td><?php echo esc_html($health['version']); ?></td>
                        </tr>
                        <tr>
                            <td><strong>Kernel</strong></td>
                            <td><?php echo $health['booted'] ? '✅ Inicializado' : '❌ Não inicializado'; ?></td>
                        </tr>
                        <tr>
                            <td><strong>Booknetic</strong></td>
                            <td><?php echo $health['booknetic_active'] ? '✅ Ativo' : '❌ Inativo'; ?></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <style>
            .limpvix-settings-container {
                max-width: 1200px;
            }
            .limpvix-card {
                background: #fff;
                border: 1px solid #ddd;
                border-radius: 4px;
                padding: 20px;
                margin-bottom: 20px;
            }
            .limpvix-card h2 {
                margin-top: 0;
                border-bottom: 1px solid #eee;
                padding-bottom: 10px;
            }
        </style>
        <?php
    }

    /**
     * Renderizar página de Dashboard
     *
     * @return void
     */
    public function renderDashboardPage(): void
    {
        if (!FinanceCapabilities::canView()) {
            wp_die('Acesso negado');
        }

        ?>
        <div class="wrap limpvix-finance">
            <h1>
                <span class="dashicons dashicons-chart-area"></span>
                Dashboard LimpVix
            </h1>

            <div class="limpvix-dashboard">
                <div class="limpvix-card">
                    <h2>📊 Estatísticas Rápidas</h2>
                    <p>Dashboard em desenvolvimento (PASSO 5.6.5)</p>

                    <?php
                    global $wpdb;

                    // Contar registros no ledger
                    $ledger_count = $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->prefix}limpvix_ledger");
                    $payouts_count = $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->prefix}limpvix_mp_payouts");
                    $orders_count = $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->prefix}limpvix_orders");
                    ?>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px;">
                        <div style="text-align: center; padding: 20px; background: #f0f0f1; border-radius: 4px;">
                            <h3 style="margin: 0; font-size: 36px; color: #2271b1;"><?php echo esc_html($orders_count); ?></h3>
                            <p style="margin: 5px 0 0 0;">Orders</p>
                        </div>
                        <div style="text-align: center; padding: 20px; background: #f0f0f1; border-radius: 4px;">
                            <h3 style="margin: 0; font-size: 36px; color: #00a32a;"><?php echo esc_html($ledger_count); ?></h3>
                            <p style="margin: 5px 0 0 0;">Eventos no Ledger</p>
                        </div>
                        <div style="text-align: center; padding: 20px; background: #f0f0f1; border-radius: 4px;">
                            <h3 style="margin: 0; font-size: 36px; color: #996800;"><?php echo esc_html($payouts_count); ?></h3>
                            <p style="margin: 5px 0 0 0;">Payouts</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <?php
    }

    /**
     * Renderizar página de Orders
     *
     * @return void
     */
    public function renderOrdersPage(): void
    {
        if (!FinanceCapabilities::canView()) {
            wp_die('Acesso negado');
        }

        // Carregar controller
        $controller = $this->getController('orders_list');

        if ($controller && method_exists($controller, 'render')) {
            $controller->render();
        } else {
            ?>
            <div class="wrap limpvix-finance">
                <h1>
                    <span class="dashicons dashicons-list-view"></span>
                    Orders Financeiras
                </h1>
                <div class="limpvix-card">
                    <p>Em desenvolvimento - PASSO 5.6.2</p>
                </div>
            </div>
            <?php
        }
    }

    /**
     * Renderizar página de Payouts
     *
     * @return void
     */
    public function renderPayoutsPage(): void
    {
        if (!FinanceCapabilities::canView()) {
            wp_die('Acesso negado');
        }

        ?>
        <div class="wrap limpvix-finance">
            <h1>
                <span class="dashicons dashicons-money-alt"></span>
                Histórico de Payouts
            </h1>
            <div class="limpvix-card">
                <p>Em desenvolvimento - PASSO 5.6.2</p>
            </div>
        </div>
        <?php
    }

    /**
     * Cleanup ao desativar plugin
     *
     * @return void
     */
    public function deactivate(): void
    {
        // Remover capabilities
        $this->capabilities->unregister();

        // Limpar transients
        delete_transient('limpvix_finance_caps_registered');
    }
}
