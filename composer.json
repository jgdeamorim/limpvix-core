{
    "name": "limpvix/core",
    "description": "LimpVix Core - Camada de governança sobre Booknetic",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": "^7.4|^8.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "LimpVix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LimpVix\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
